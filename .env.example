# Environment variables for the 404 TradeOS marketing site.
# Copy to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real values — .env* is
# gitignored except this file.
#
# No environment variables are required for `npm run build` to succeed.
# The two NEXT_PUBLIC_* variables below are inlined into the client bundle
# at BUILD time if present — set them before building/deploying, not just
# at runtime, or the shipped bundle won't carry real values (a change to
# them in Vercel needs a rebuild to take effect). The four server-only
# variables are read at request time and don't need a rebuild.

# --- Public (browser-visible) ---
# Exposed to client-side JavaScript via Next.js's NEXT_PUBLIC_ prefix.
# Required for: proxy.ts — the site's Next.js 16 middleware (auto-detected
# by file name/location at the repo root, no import needed; renamed from
# middleware.ts in this Next.js version) — plus the admin login/dashboard
# (lib/supabase-server.ts, lib/supabase-browser.ts).

# Supabase project URL (Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key — safe for browser exposure; access is
# constrained by the project's Row Level Security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never exposed to the browser) ---

# Supabase service-role key — bypasses Row Level Security. Used only by
# lib/supabase.ts (getSupabaseAdmin), and only by app/api/contact/route.ts
# to insert new leads. Treat as highly sensitive; never prefix with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key. Used only by lib/resend.ts, and only by
# app/api/contact/route.ts to send lead notification emails.
RESEND_API_KEY=

# The "from" address for lead notification emails. Must be an address on a
# domain verified in the Resend account, or sending will fail.
RESEND_FROM=hello@404tradeos.com

# Inbox that receives new-lead notification emails.
CONTACT_NOTIFICATION_EMAIL=billy@404tradeos.com
